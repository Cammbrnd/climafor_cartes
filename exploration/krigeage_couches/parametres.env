# Reglages du krigeage des couches de l'onglet Carte (exploration, hors application).
# Un changement de ce fichier envoye sur la branche relance le calcul ; les entrees du lancement
# manuel (annee, lecture seule) remplacent ces valeurs. Seules les lignes KRIGEAGE_NOM=valeur
# sobres (lettres, chiffres, virgules, points) sont lues par le workflow.

# Annee cartographiee (doit figurer dans le jeu publie par ClimaFor : 1959 a la derniere annee complete)
KRIGEAGE_ANNEE=2025

# oui = lit les fichiers publies, les resume dans le journal, puis s'arrete (verification rapide, sans calcul)
KRIGEAGE_LECTURE_SEULE=non

# Taille de maille de la surface, en metres (minimum 500)
KRIGEAGE_RESOLUTION_M=500

# Finesse des tuiles d'altitude AWS : 12 = environ 30 m (la moyenne par maille de 500 m en est tres proche)
KRIGEAGE_MNT_ZOOM=12

# Definition des images (points par pouce) ; une carte fait 9 x 8,5 pouces
KRIGEAGE_DPI=200
