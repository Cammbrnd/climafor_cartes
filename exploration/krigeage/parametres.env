# Parametres du calcul (lus par le workflow « Krigeage P-ETP estival »).
# Modifier ce fichier et l'envoyer sur la branche relance le calcul.
# Une valeur vide = valeur par defaut du script.

# Annee de l'ete (juin a aout)
KRIGEAGE_ANNEE=2026

# Departements, separes par des virgules (ex. 31,09,2A). Vide = France metropolitaine entiere.
KRIGEAGE_DEPARTEMENTS=

# Part minimale de jours exploitables (pluie ET temperatures) sur juin-aout
KRIGEAGE_SEUIL=0.95

# Taille de maille de la carte, en metres
KRIGEAGE_RESOLUTION_M=1000

# MNT : oui = l'altitude moyenne de chaque maille sert de tendance (krigeage a derive externe),
# non = krigeage ordinaire. Les fichiers avec MNT portent le suffixe _mnt.
KRIGEAGE_MNT=oui

# Finesse des tuiles d'altitude : 7 (environ 0,9 km), 8 (0,4 km), 9 (0,2 km), 10, 11 ou 12 (environ 27 m ; la donnee
# source, SRTM / EU-DEM, est a 25-30 m). Au-dela de 9, les tuiles (environ 28 000 au zoom 12) sont telechargees en
# parallele puis moyennees par blocs avant l'assemblage : la moyenne par maille de 1 km est celle du MNT d'origine.
# La maille du krigeage (KRIGEAGE_RESOLUTION_M) doit rester au moins 3 a 4 fois plus grande que la tuile.
KRIGEAGE_MNT_ZOOM=12

# Covariables candidates en plus de l'altitude : expo (exposition des versants), mer (distance a la mer).
# Chaque combinaison est evaluee par validation croisee et la meilleure est retenue.
# Vide = altitude seule (choix retenu : les essais de 2026 n'ont rien apporte, voir resultats/2026/exposition_echelles_2026.csv).
# Pour les tester a nouveau : KRIGEAGE_COVARIABLES=expo,mer
KRIGEAGE_COVARIABLES=

# Echelles (km) de la pente et de l'exposition, separees par des virgules (utilise seulement si expo est dans
# KRIGEAGE_COVARIABLES). 1-2 km = versant de vallee, 5 km = relief regional. Minimum 1 km.
KRIGEAGE_EXPO_ECHELLE_KM=1,2,5
